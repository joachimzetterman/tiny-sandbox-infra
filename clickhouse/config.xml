<!-- Keeps ClickHouse small enough for a laptop demo. -->
<clickhouse>
    <!-- Hard cap on server memory, below the container limit in compose.yaml. -->
    <max_server_memory_usage>1073741824</max_server_memory_usage>
    <mark_cache_size>67108864</mark_cache_size>

    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>

    <!-- System log tables write and merge all the time. The demo does not read them. -->
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <query_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
    <part_log remove="1"/>
    <error_log remove="1"/>
    <latency_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <backup_log remove="1"/>
    <blob_storage_log remove="1"/>
</clickhouse>
